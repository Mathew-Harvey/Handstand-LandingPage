# Copy to .env for local dev. On Render, set these in the dashboard (never commit real keys).

STRIPE_SECRET_KEY=sk_live_xxxx
STRIPE_PRICE_ID=price_xxxx
SITE_URL=https://your-app.onrender.com
PDF_DOWNLOAD_URL=/handstand.pdf

# Tracker: backend API (create-user) and app URL (set-password link in email). See TRACKER_BACKEND_CONTRACT.md.
TRACKER_API_URL=https://handstand-api.onrender.com/api/users
TRACKER_API_SECRET=your-shared-secret-same-as-backend
TRACKER_LOGIN_URL=https://handstand-web.onrender.com

# Email (required for "Send me my tracker login")
EMAIL_FROM=The Bodyweight Gym <onboarding@resend.dev>
RESEND_API_KEY=re_xxxx
# Or use SendGrid: SENDGRID_API_KEY, EMAIL_PROVIDER=sendgrid
