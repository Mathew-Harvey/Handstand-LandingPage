# Copy to .env for local dev. On Render, set these in the dashboard (never commit real keys).

STRIPE_SECRET_KEY=sk_live_xxxx
STRIPE_PRICE_ID=price_xxxx
SITE_URL=https://your-app.onrender.com
PDF_DOWNLOAD_URL=/handstand.pdf

# Tracker login email (required for "Send me my tracker login" to actually send)
TRACKER_LOGIN_URL=https://your-tracker-app.com/login
EMAIL_FROM=The Bodyweight Gym <noreply@yourdomain.com>
RESEND_API_KEY=re_xxxx
# Or use SendGrid and set EMAIL_PROVIDER=sendgrid
# SENDGRID_API_KEY=SG.xxxx
# EMAIL_PROVIDER=sendgrid

# Optional: create tracker user via API before sending email
# TRACKER_API_URL=https://your-tracker-api.com/api/users
# TRACKER_API_SECRET=your-secret
